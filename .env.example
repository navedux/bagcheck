NANSEN_API_KEY=
# Must stay https://api.nansen.ai/api/v1. Any other host is rejected.
NANSEN_BASE_URL=https://api.nansen.ai/api/v1
# sim = deterministic in-app market simulator (no key needed)
# live = real Nansen calls (needs NANSEN_API_KEY)
# snapshot = saved Nansen reads for the featured tokens (default, no key)
DATA_MODE=snapshot
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=30
# Credit guard. Credits per day, then cold checks per client and per instance per hour.
DAILY_CALL_CAP=400
COLD_CHECKS_PER_CLIENT_HOUR=10
COLD_CHECKS_PER_HOUR=60
ALLOWED_ORIGINS=http://localhost:3000

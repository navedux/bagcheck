NANSEN_API_KEY=
# Must stay https://api.nansen.ai/api/v1. Any other host is rejected.
NANSEN_BASE_URL=https://api.nansen.ai/api/v1
# sim = deterministic in-app market simulator (no key needed)
# live = real Nansen calls (needs NANSEN_API_KEY)
# snapshot = committed fixtures only (public deploy, CI)
DATA_MODE=sim
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=30
DAILY_CALL_CAP=800
ALLOWED_ORIGINS=http://localhost:3000
